# ============================================================================
# 前端环境变量样例 (Step 14)
# ----------------------------------------------------------------------------
# 复制为 .env.local 后修改:
#   cp .env.local.example .env.local
#
# VITE_MOCK_SPLAT_BUILDING - 强制特定楼走 splat 模式 (dev 测试用)
#   值为 building_code 末段 (下划线后最后一段), 大小写不敏感
#   例如: Bobcat_education_Tammy -> 设为 Tammy
#   启用后该楼会从 /mock/mock_splat.ply 加载 100 高斯点做渲染验证
#   不设则按后端 model_kind 决定 (block / splat / estimated)
#
# VITE_MOCK_SPLAT_BUILDING=Tammy
