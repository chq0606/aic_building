# 复制为 .env 后按本机情况改值。本文件提交进 git，.env 不提交。
# 字段分两批：第一批 Step 01 启动必须配置；第二批后续 step 用，先
# 占位避免 pydantic-settings 校验报缺（有默认值的可以不写）。

# 应用基础
APP_NAME=建筑能耗分析与节能优化平台
APP_VERSION=0.1.0
ENV=dev
HOST=0.0.0.0
PORT=8000

# 日志
LOG_LEVEL=INFO
LOG_DIR=logs

# 数据库
# 用 DATABASE_URL 一行式给全连接串，后续 Step 03 迁移 seed 脚本时也走这里，
# 不再保留 PGPASSWORD 这种散装五件套写法。
DATABASE_URL=postgresql://postgres:你的密码@localhost:5432/aic_building
DB_POOL_MIN=2
DB_POOL_MAX=10
# 每次 checkout 连接后先 SET search_path 到这个值，避免 schema 前缀写死
DB_SEARCH_PATH=core, ingest, fact, mart, knowledge, visual, public

# CORS，前端 vite dev server 默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT，Step 02 用。生产改随机 32+ 位字符串
JWT_SECRET=dev_only_change_me_in_production
JWT_ALG=HS256
JWT_EXPIRE_HOURS=24
JWT_REFRESH_DAYS=7

# 智谱 GLM，Step 18 AI 抽屉用
GLM_API_KEY=
GLM_MODEL=glm-4.5

# BGE embedding，Step 09 知识库用。空字符串=未启用
BGE_MODEL_PATH=
BGE_DIM=1024

# Redis，Step 12 job queue 的备选方案。一期用 PG 表 + SELECT FOR UPDATE
# SKIP LOCKED 轮询，留空即可
REDIS_URL=
