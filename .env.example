# ============================================================================
# .env.example - docker-compose 环境变量样例
# ----------------------------------------------------------------------------
# 用法:
#   cp .env.example .env
#   # 改 .env 里 GLM_API_KEY / JWT_SECRET 等
#   docker compose up -d
# ============================================================================

# PostgreSQL 数据库密码 (生产环境一定要改)
POSTGRES_PASSWORD=postgres

# JWT 签名密钥 (生产环境一定要改成 32+ 字符随机串)
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev_only_change_me_in_production

# 智谱 GLM API Key (AI 抽屉用, 留空则 AI 抽屉返诊断错误, 其他功能不受影响)
# 申请: https://open.bigmodel.cn/
GLM_API_KEY=

# 智谱 GLM 模型名 (可选, 默认 glm-4.5)
GLM_MODEL=glm-4.5

# BGE embedding 模型路径 (留空则用 sentence-transformers 默认下载到 ~/.cache/huggingface)
# 国内推荐: 设 HF_ENDPOINT=https://hf-mirror.com 加速
BGE_MODEL_PATH=

# 运行环境 (dev 显示 /api/v1/docs, prod 关掉)
ENV=prod

# CORS 允许的前端 origin, 逗号分隔
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# GitHub 仓库链接 (前端 AboutPanel 显示用, 留空显示"暂未公开")
APP_REPO_URL=
