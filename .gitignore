# ============================================================================
# .gitignore - AIC Building 项目
# ============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# 虚拟环境
.venv/
venv/
env/
build/
dist/

# ---- Node / Frontend ----
node_modules/
dist/
.pnpm-store/
*.log
.vite/
.eslintcache

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- 项目数据 (不进 git) ----
# PostgreSQL 数据卷
data/postgres/

# 上传文件 (CSV / PDF / 照片)
code/backend/data/uploads/
code/backend/data/imports/

# 运行时产物 (模型权重/上传文件/重建输出), 全部不进 git, 由 docker volume 或应用运行时生成
code/backend/storage/

# 日志
code/backend/logs/
*.log

# ---- 配置 (含密钥, 不进 git) ----
.env
.env.local
.env.production

# ---- 临时 / 调试 ----
*.tmp
*.bak
*.orig
.cache/
tmp/

# ---- 原始数据 / 测试文件 ----
# BDG2 全量原始数据 (355MB) 不进 git, demo 种子数据在 extracted_data/ (已提交)
dataset/
# 国标 PDF (381MB, 有版权) 不进 git, 用户自行下载或用 sample
test_pdfs/
